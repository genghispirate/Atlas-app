<resources>
    <string name="accessibility_service_label">Pact 应用护盾</string>
    <string name="accessibility_service_description">Pact 只将此权限用于一件事：察觉被锁定的应用来到前台，以便显示锁定画面。它绝不读取你的屏幕内容，不收集任何数据，且完全离线运行。</string>

    <string name="common_continue">继续</string>
    <string name="common_cancel">取消</string>
    <string name="common_close">关闭</string>
    <string name="common_done">完成</string>
    <string name="common_next">下一步</string>
    <string name="common_back">返回</string>
    <string name="common_remove">移除</string>
    <string name="common_skip">跳过</string>

    <string name="intro_page1_title">锁住让你沉迷的应用</string>
    <string name="intro_page1_body">Pact 会屏蔽你放不下的应用——Instagram、TikTok、YouTube，随你选。它们会一直锁着，直到有人放你回去。</string>
    <string name="intro_page2_title">是一个人，不是一串密码</string>
    <string name="intro_page2_body">你选择一位守护人——伴侣、父母或挚友。只有他们给出的最新 6 位验证码才能解锁你的应用。意志力不再是薄弱环节。</string>
    <string name="intro_page3_title">私密、离线、属于你</string>
    <string name="intro_page3_body">没有账号，没有服务器，永远不需要联网。验证码和两步验证码原理相同，守护人在电话里念给你听就行。</string>
    <string name="intro_get_started">开始使用</string>

    <string name="role_title">这部手机是谁的？</string>
    <string name="role_body">Pact 有两个角色：锁定自己应用的人，和保管钥匙的人。</string>
    <string name="role_user_title">锁定我的应用</string>
    <string name="role_user_body">我想锁住让我分心的应用，把钥匙交给信任的人。</string>
    <string name="role_sponsor_title">我是守护人</string>
    <string name="role_sponsor_body">我在乎的人请我保管他们的解锁验证码。</string>

    <string name="guardian_title">选择你的守护人</string>
    <string name="guardian_body">选一个盼你变好的人——伴侣、父母、挚友。解锁验证码由他们保管，每次解锁都要先开口问他们。</string>
    <string name="guardian_name_label">对方的名字</string>
    <string name="guardian_hint">选一个容易联系上的人——每次想解锁都需要他们。</string>

    <string name="pair_title">交出钥匙</string>
    <string name="pair_body">这个二维码就是你所有锁的钥匙。它只显示这一次——现在——它属于%1$s，不属于你。</string>
    <string name="pair_qr_desc">配对二维码</string>
    <string name="pair_on_their_phone">在%1$s的手机上：</string>
    <string name="pair_step1">安装 Pact——就是你正在用的这个应用</string>
    <string name="pair_step2">设置时选择「我是守护人」</string>
    <string name="pair_step3">用那里的扫码按钮扫这个二维码</string>
    <string name="pair_alt_authenticator">不想装应用？Google Authenticator 或任何两步验证应用也能扫这个码。手动密钥：%1$s</string>
    <string name="pair_warning">别用自己的手机扫——那等于把自己锁的钥匙留在自己手里。</string>
    <string name="pair_confirm">钥匙已交给%1$s</string>

    <string name="prove_title">验证一下</string>
    <string name="prove_body">问%1$s现在屏幕上显示的 6 位验证码。</string>
    <string name="prove_error">不对。请确认对方扫过上一步的二维码，再试当前显示的验证码。</string>
    <string name="prove_show_qr">再次显示二维码</string>

    <string name="perm_title">升起护盾</string>
    <string name="perm_body">一项 Android 权限能让 Pact 察觉被锁应用打开，从而挡在前面。授予步骤如下：</string>
    <string name="perm_step1">点下方「打开设置」</string>
    <string name="perm_step2">在列表中找到「Pact 应用护盾」——有时在「已安装的应用」或「已下载的应用」下</string>
    <string name="perm_step3">点进去并打开开关</string>
    <string name="perm_step4">Android 会弹出警告——这是正常的。Pact 只知道哪个应用被打开，绝不读取屏幕内容。点「允许」</string>
    <string name="perm_step5">回到这里——成功后本页会变绿</string>
    <string name="perm_status_on">护盾已升起，你受保护了。</string>
    <string name="perm_status_waiting">等待护盾开启…</string>
    <string name="perm_open_settings">打开设置</string>
    <string name="perm_later">稍后再说</string>

