    <string name="change_sponsor_body">首先需要%1$s的验证码来批准这次更换。</string>
    <string name="end_pact_title">终止 Pact？</string>
    <string name="end_pact_body">向%1$s索取当前验证码，以解除所有锁定并重置。</string>
